{
  "seed": 42,
  "labels": [
    "Anger",
    "Disgust",
    "Enjoyment",
    "Fear",
    "Other",
    "Sadness",
    "Surprise"
  ],
  "svm": {
    "C": 1.0,
    "class_weight": "balanced",
    "word_ngram": [
      1,
      3
    ],
    "char_ngram": [
      3,
      5
    ]
  },
  "cnn": {
    "embedding_dim": 300,
    "filters": 128,
    "kernel_sizes": [
      3,
      4,
      5
    ],
    "dropout": 0.5,
    "batch_size": 64,
    "epochs": 20,
    "patience": 4,
    "learning_rate": 0.001,
    "max_length": 64,
    "word2vec_epochs": 20
  },
  "transformer": {
    "max_length": 128,
    "batch_size": 4,
    "gradient_accumulation_steps": 4,
    "epochs": 4,
    "patience": 2,
    "learning_rate": 2e-05,
    "weight_decay": 0.01
  },
  "pretrained": {
    "phobert": "vinai/phobert-base-v2",
    "visobert": "uitnlp/visobert"
  },
  "preprocessing": {
    "version": "nfc_pyvi_v1",
    "phobert": "Pyvi word segmentation",
    "visobert": "normalized original text",
    "cnn": "Pyvi lowercase",
    "svm": "Pyvi word + original character"
  }
}